+namespace {
+
+// Copy a save folder tree, leaving out the shader cache (large, rebuilt on demand).
+bool CopySaves(const std::filesystem::path& from, const std::filesystem::path& to,
+               std::string* error) {
+  std::error_code ec;
+  std::filesystem::create_directories(to, ec);
+  for (auto& entry : std::filesystem::directory_iterator(from, ec)) {
+    if (entry.path().filename() == "cache")
+      continue;
+    std::filesystem::copy(entry.path(), to / entry.path().filename(),
+                          std::filesystem::copy_options::recursive |
+                              std::filesystem::copy_options::overwrite_existing,
+                          ec);
+    if (ec) {
+      *error = ec.message();
+      return false;
+    }
+  }
+  if (ec) {
+    *error = ec.message();
+    return false;
+  }
+  return true;
+}
+
