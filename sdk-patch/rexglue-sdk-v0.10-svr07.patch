+// SVR07: Windows paths contain backslashes, which are escapes in TOML basic
+// strings; unescaped they made the whole saved config fail to parse on the next
+// launch (all settings silently reset).
+static std::string EscapeTomlString(const std::string& value) {
+  std::string out;
+  out.reserve(value.size());
+  for (char c : value) {
+    if (c == '\\' || c == '"') {
+      out += '\\';
+    }
+    out += c;
+  }
+  return out;
+}
+
+// Values given on the command line or via environment are one-off launch
+// overrides (e.g. --user_data_root from a launcher); don't bake them into the file.
+template <typename Entry>
+static bool IsPersistedSource(const Entry& entry) {
+  return entry.source != Source::kCommandLine && entry.source != Source::kEnvironment;
+}
+
