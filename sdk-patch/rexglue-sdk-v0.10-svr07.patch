+void LogStackTrace(CONTEXT* context) {
+  HANDLE process = GetCurrentProcess();
+  SymSetOptions(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS | SYMOPT_LOAD_LINES);
+  SymInitialize(process, nullptr, TRUE);
+
+  CONTEXT ctx = *context;
+  STACKFRAME64 frame = {};
+  frame.AddrPC.Offset = ctx.Rip;
+  frame.AddrPC.Mode = AddrModeFlat;
+  frame.AddrFrame.Offset = ctx.Rbp;
+  frame.AddrFrame.Mode = AddrModeFlat;
+  frame.AddrStack.Offset = ctx.Rsp;
+  frame.AddrStack.Mode = AddrModeFlat;
+
+  alignas(SYMBOL_INFO) char symbol_buffer[sizeof(SYMBOL_INFO) + 256];
+  auto* symbol = reinterpret_cast<SYMBOL_INFO*>(symbol_buffer);
+  for (int i = 0; i < 48; ++i) {
+    if (!StackWalk64(IMAGE_FILE_MACHINE_AMD64, process, GetCurrentThread(), &frame, &ctx, nullptr,
+                     SymFunctionTableAccess64, SymGetModuleBase64, nullptr) ||
+        !frame.AddrPC.Offset) {
+      break;
+    }
+    DWORD64 address = frame.AddrPC.Offset;
+    std::memset(symbol_buffer, 0, sizeof(symbol_buffer));
+    symbol->SizeOfStruct = sizeof(SYMBOL_INFO);
+    symbol->MaxNameLen = 255;
+    DWORD64 symbol_offset = 0;
+    IMAGEHLP_LINE64 line = {sizeof(IMAGEHLP_LINE64)};
+    DWORD line_offset = 0;
+    bool has_symbol = SymFromAddr(process, address, &symbol_offset, symbol);
+    bool has_line = SymGetLineFromAddr64(process, address, &line_offset, &line);
+    REXLOG_CRITICAL("  #{:02} {:016X} {}+0x{:X} {}:{}", i, address,
+                    has_symbol ? symbol->Name : "?", symbol_offset,
+                    has_line ? line.FileName : "", has_line ? line.LineNumber : 0);
+  }
+}
+
+void WriteMiniDump(EXCEPTION_POINTERS* exception_pointers) {
+  std::error_code ec;
+  std::filesystem::create_directories(g_crash_dump_dir, ec);
+  SYSTEMTIME t;
+  GetLocalTime(&t);
+  wchar_t name[64];
+  swprintf_s(name, L"crash_%04u%02u%02u_%02u%02u%02u.dmp", t.wYear, t.wMonth, t.wDay, t.wHour,
+             t.wMinute, t.wSecond);
+  auto path = g_crash_dump_dir / name;
+  HANDLE file = CreateFileW(path.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS,
+                            FILE_ATTRIBUTE_NORMAL, nullptr);
+  if (file == INVALID_HANDLE_VALUE) {
+    return;
+  }
+  MINIDUMP_EXCEPTION_INFORMATION info = {GetCurrentThreadId(), exception_pointers, FALSE};
+  // Stacks and thread state only: the guest memory arena is far too large to include.
+  auto type = MINIDUMP_TYPE(MiniDumpWithIndirectlyReferencedMemory | MiniDumpWithThreadInfo |
+                            MiniDumpWithUnloadedModules);
+  if (MiniDumpWriteDump(GetCurrentProcess(), GetCurrentProcessId(), file, type,
+                        exception_pointers ? &info : nullptr, nullptr, nullptr)) {
+    REXLOG_CRITICAL("Minidump written to {}", path.string());
+  }
+  CloseHandle(file);
+}
+
+LONG WINAPI UnhandledExceptionCallback(EXCEPTION_POINTERS* exception_pointers) {
+  if (g_crash_handled.exchange(true)) {
+    return EXCEPTION_CONTINUE_SEARCH;
+  }
+  const EXCEPTION_RECORD* record = exception_pointers->ExceptionRecord;
+  HMODULE module = nullptr;
+  char module_path[MAX_PATH] = "?";
+  if (GetModuleHandleExA(
+          GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+          static_cast<LPCSTR>(record->ExceptionAddress), &module)) {
+    GetModuleFileNameA(module, module_path, MAX_PATH);
+  }
+  REXLOG_CRITICAL("Unhandled host exception 0x{:08X} at {:016X} ({}+0x{:X}) on thread {}",
+                  uint32_t(record->ExceptionCode),
+                  reinterpret_cast<uintptr_t>(record->ExceptionAddress),
+                  std::filesystem::path(module_path).filename().string(),
+                  reinterpret_cast<uintptr_t>(record->ExceptionAddress) -
+                      reinterpret_cast<uintptr_t>(module),
+                  GetCurrentThreadId());
+  if (record->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && record->NumberParameters >= 2) {
+    REXLOG_CRITICAL("  {} of address {:016X}",
+                    record->ExceptionInformation[0] == 1   ? "write"
+                    : record->ExceptionInformation[0] == 8 ? "execute"
+                                                           : "read",
+                    record->ExceptionInformation[1]);
+  }
+  LogStackTrace(exception_pointers->ContextRecord);
+  WriteMiniDump(exception_pointers);
+  rex::ShutdownLogging();
+  return EXCEPTION_CONTINUE_SEARCH;
+}
+
+void AbortSignalHandler(int) {
+  if (g_crash_handled.exchange(true)) {
+    return;
+  }
+  CONTEXT context;
+  RtlCaptureContext(&context);
+  REXLOG_CRITICAL("abort() called on thread {}", GetCurrentThreadId());
+  LogStackTrace(&context);
+  WriteMiniDump(nullptr);
+  rex::ShutdownLogging();
+}
+
+void InstallCrashHandler(const std::filesystem::path& dump_dir) {
+  g_crash_dump_dir = dump_dir;
+  SetUnhandledExceptionFilter(UnhandledExceptionCallback);
+  std::signal(SIGABRT, AbortSignalHandler);
+}
