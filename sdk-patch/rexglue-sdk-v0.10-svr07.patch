+void SharedMemory::VerifyValidPages(
+    const std::vector<std::pair<uint32_t, uint32_t>>& ranges) {
+  // Called with the global critical region held. A CPU-uploaded page that is
+  // still valid must not have changed in guest memory: a write would have hit
+  // the write watch and invalidated it first.
+  if (debug_page_hashes_.size() != (kBufferSize >> page_size_log2_)) {
+    return;
+  }
+  for (const std::pair<uint32_t, uint32_t>& range : ranges) {
+    uint32_t page_first = range.first >> page_size_log2_;
+    uint32_t page_last = (range.first + range.second - 1) >> page_size_log2_;
+    for (uint32_t page = page_first; page <= page_last; ++page) {
+      uint64_t bit = uint64_t(1) << (page & 63);
+      if (!(system_page_flags_valid_[page >> 6] & bit) ||
+          (system_page_flags_valid_and_gpu_written_[page >> 6] & bit)) {
+        continue;
+      }
+      uint64_t& stored = debug_page_hashes_[page];
+      if (!stored) {
+        continue;
+      }
+      uint64_t current = XXH3_64bits(memory().TranslatePhysical(page << page_size_log2_),
+                                     size_t(1) << page_size_log2_);
+      if (current != stored) {
+        ++debug_stale_page_count_;
+        if (debug_stale_page_count_ <= 200 || !(debug_stale_page_count_ & 1023)) {
+          REXGPU_WARN("Shared memory: stale page {:08X} (guest changed it without "
+                      "invalidation), total {}",
+                      page << page_size_log2_, debug_stale_page_count_);
+        }
+        stored = current;
+      }
+    }
+  }
