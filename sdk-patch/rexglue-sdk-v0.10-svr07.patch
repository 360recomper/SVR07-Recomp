+    if (entry.getter() != entry.default_value && IsPersistedSource(entry)) {
       if (entry.type == FlagType::String) {
-        result += entry.name + " = \"" + entry.getter() + "\"\n";
+        result += entry.name + " = \"" + EscapeTomlString(entry.getter()) + "\"\n";
